# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique du site (liens de confirmation d'e-mail et retour OAuth Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé de service — SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_.
# Elle sert au moteur à écrire les résultats de match sans passer par le RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
